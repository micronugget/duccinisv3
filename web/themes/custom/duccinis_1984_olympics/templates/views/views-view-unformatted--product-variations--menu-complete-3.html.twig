{#
/**
 * @file
 * Product sub-group template for Product Variations: Menu complete 3.
 *
 * Called once per product title group (the inner grouping level).
 * Renders a product sub-header (h3) with its variation rows inside.
 *
 * The outer category accordion item is rendered by:
 * views-view-grouping--product-variations--menu-complete-3.html.twig
 *
 * Available variables:
 * - title: The product title (rendered markup).
 * - rows: The variation rows for this product.
 */
#}
{% set group_title_clean = title|render|striptags|trim %}

{% if title %}
  <div class="menu-product-group">
    <h3 class="menu-product-group__title">{{ group_title_clean }}</h3>
    {% for row in rows %}
      <div{{ row.attributes.addClass('menu-variation-row') }}>
        {{ row.content }}
      </div>
    {% endfor %}
  </div>
{% else %}
  {% for row in rows %}
    <div{{ row.attributes.addClass('menu-variation-row') }}>
      {{ row.content }}
    </div>
  {% endfor %}
{% endif %}
