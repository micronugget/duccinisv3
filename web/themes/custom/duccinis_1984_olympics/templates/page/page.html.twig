{#
/**
 * @file
 * Global page template override — used for all non-front pages.
 *
 * Delegates most rendering to radix:page but overrides the footer block to
 * render the duccinis-footer SDC component instead of radix:page-footer.
 *
 * @see template_preprocess_page()
 */
#}
{%
  embed 'radix:page' with {
    page_main_utility_classes: [],
    page_header_container_utility_classes: [],
  }
%}
  {% block page_footer %}
    {% include 'duccinis_1984_olympics:duccinis-footer' %}
  {% endblock %}
{% endembed %}
