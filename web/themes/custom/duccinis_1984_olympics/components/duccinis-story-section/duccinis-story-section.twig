{#
/**
 * @file
 * Duccinis story-section — 2-col story + stats grid.
 *
 * Props:
 *   section_label, headline_l1, headline_l2 (string)
 *   paragraphs (array<string>)
 *   stats (array<{number, label}>)
 */
#}
{% set story_paragraphs = paragraphs is defined and paragraphs is not empty ? paragraphs : [] %}
{% set story_stats = stats is defined and stats is not empty ? stats : [] %}
<section class="duccinis-story-section" id="story"
  aria-labelledby="story-section-title">
  <div class="duccinis-story-section__container">
    <div class="duccinis-story-section__grid">

      <div class="duccinis-story-section__text">
        {% if section_label %}
          <div class="duccinis-story-section__label">{{ section_label }}</div>
        {% endif %}
        <h2 class="duccinis-story-section__title" id="story-section-title">
          {% if headline_l1 %}{{ headline_l1 }}<br>{% endif %}
          {% if headline_l2 %}{{ headline_l2 }}{% endif %}
        </h2>
        {% for para in story_paragraphs %}
          <p class="duccinis-story-section__para">{{ para }}</p>
        {% endfor %}
      </div>

      <div class="duccinis-story-section__stats" aria-label="Key facts">
        {% for stat in story_stats %}
          <div class="duccinis-story-section__stat">
            <span class="duccinis-story-section__stat-num">{{ stat.number }}</span>
            <span class="duccinis-story-section__stat-label">{{ stat.label }}</span>
          </div>
        {% endfor %}
      </div>

    </div>
  </div>
</section>
