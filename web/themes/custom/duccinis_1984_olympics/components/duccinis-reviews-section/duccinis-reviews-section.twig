{#
/**
 * @file
 * Duccinis reviews-section — 3-col customer reviews grid.
 *
 * Props:
 *   section_label, headline_l1, headline_l2 (string)
 *   reviews (array<{text, author, source, stars}>)
 */
#}
{% set review_items = reviews is defined and reviews is not empty ? reviews : [] %}
<section class="duccinis-reviews-section" id="reviews"
  aria-labelledby="reviews-section-title">
  <div class="duccinis-reviews-section__container">
    {% if section_label %}
      <div class="duccinis-reviews-section__label">{{ section_label }}</div>
    {% endif %}
    <h2 class="duccinis-reviews-section__title" id="reviews-section-title">
      {% if headline_l1 %}{{ headline_l1 }}<br>{% endif %}
      {% if headline_l2 %}{{ headline_l2 }}{% endif %}
    </h2>
    <div class="duccinis-reviews-section__grid">
      {% for review in review_items %}
        <article class="duccinis-reviews-section__card">
          <div class="duccinis-reviews-section__quote" aria-hidden="true">"</div>
          <div class="duccinis-reviews-section__stars"
            aria-label="{{ review.stars|default(5) }} stars">
            {% for i in 1..review.stars|default(5) %}
              <span aria-hidden="true">★</span>
            {% endfor %}
          </div>
          <p class="duccinis-reviews-section__text">{{ review.text }}</p>
          <div class="duccinis-reviews-section__author">{{ review.author }}</div>
          {% if review.source %}
            <div class="duccinis-reviews-section__source">{{ review.source }}</div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>
