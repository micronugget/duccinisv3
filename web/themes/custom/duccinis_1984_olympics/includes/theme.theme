<?php

/**
 * @file
 * Custom theme hooks.
 */

/**
 * Implements hook_page_attachments_alter().
 *
 * Attaches the homepage JS library (scroll-reveal, nav-scroll, store badge)
 * only on the front page to avoid loading unused behaviors on every page.
 */
function duccinis_1984_olympics_page_attachments_alter(array &$attachments): void {
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $attachments['#attached']['library'][] = 'duccinis_1984_olympics/homepage';
  }
}

/**
 * Implements hook_page_attachments().
 *
 * Adds preconnect hints for Google Fonts to minimise CLS when DM Sans loads.
 */
function duccinis_1984_olympics_page_attachments(array &$attachments): void {
  $attachments['#attached']['html_head'][] = [
    [
      '#tag' => 'link',
      '#attributes' => [
        'rel' => 'preconnect',
        'href' => 'https://fonts.googleapis.com',
      ],
    ],
    'google_fonts_preconnect',
  ];
  $attachments['#attached']['html_head'][] = [
    [
      '#tag' => 'link',
      '#attributes' => [
        'rel' => 'preconnect',
        'href' => 'https://fonts.gstatic.com',
        'crossorigin' => TRUE,
      ],
    ],
    'google_fonts_gstatic_preconnect',
  ];
}
